+// Vector storage is reversed relative to guest byte order.
+// Return by value so the destination may alias either source.
+inline PPCVRegister ppc_vaddsws(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister d{};
+    for (unsigned i = 0; i < 4; ++i) {
+        const int64_t sum = int64_t(a.s32[i]) + int64_t(b.s32[i]);
+        if (sum > INT32_MAX) { d.s32[i] = INT32_MAX; vscr |= 1; }
+        else if (sum < INT32_MIN) { d.s32[i] = INT32_MIN; vscr |= 1; }
+        else d.s32[i] = int32_t(sum);
+    }
+    return d;
+}
+inline PPCVRegister ppc_vadduhs(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister d{};
+    for (unsigned i = 0; i < 8; ++i) {
+        const uint32_t sum = uint32_t(a.u16[i]) + b.u16[i];
+        if (sum > UINT16_MAX) { d.u16[i] = UINT16_MAX; vscr |= 1; }
+        else d.u16[i] = uint16_t(sum);
+    }
+    return d;
+}
+inline PPCVRegister ppc_vpkswss(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister d{};
+    for (unsigned i = 0; i < 8; ++i) {
+        const int32_t n = i < 4 ? b.s32[i] : a.s32[i - 4];
+        if (n > INT16_MAX) { d.s16[i] = INT16_MAX; vscr |= 1; }
+        else if (n < INT16_MIN) { d.s16[i] = INT16_MIN; vscr |= 1; }
+        else d.s16[i] = int16_t(n);
+    }
+    return d;
+}
+inline PPCVRegister ppc_vpkuwus(const PPCVRegister& a, const PPCVRegister& b, uint32_t& vscr)
+{
+    PPCVRegister d{};
+    for (unsigned i = 0; i < 8; ++i) {
+        const uint32_t n = i < 4 ? b.u32[i] : a.u32[i - 4];
+        if (n > UINT16_MAX) { d.u16[i] = UINT16_MAX; vscr |= 1; }
+        else d.u16[i] = uint16_t(n);
+    }
+    return d;
+}
+inline PPCVRegister ppc_vctuxs(const PPCVRegister& b, unsigned shift, uint32_t& vscr)
+{
+    PPCVRegister d{};
+    for (unsigned i = 0; i < 4; ++i) {
+        const float n = b.f32[i] * float(uint32_t(1) << shift);
+        if (std::isnan(n)) d.u32[i] = 0; // NaN leaves SAT unchanged.
+        else if (n < 0.0f) { d.u32[i] = 0; vscr |= 1; }
+        else if (n >= 4294967296.0f) { d.u32[i] = UINT32_MAX; vscr |= 1; }
+        else d.u32[i] = uint32_t(n);
+    }
+    return d;
+}
+inline PPCVRegister ppc_vsro(const PPCVRegister& a, const PPCVRegister& b)
+{
+    PPCVRegister d{};
+    const unsigned shift = (b.u8[0] >> 3) & 15;
+    for (unsigned i = 0; i + shift < 16; ++i) d.u8[i] = a.u8[i + shift];
+    return d;
+}
